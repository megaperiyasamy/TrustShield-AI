# Generate a long random secret before deployment (never commit the real value).
TRUSTSHIELD_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
# Optional hosted database. If omitted, a local SQLite file is used.
# DATABASE_URL=postgresql://user:password@host:5432/trustshield
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep uploads/reports on persistent storage in production.
# TRUSTSHIELD_STORAGE_DIR=/var/data/trustshield
# Set to your deployed frontend URL so password reset links point to the website.
FRONTEND_URL=http://localhost:5173
# Optional SMTP settings for actual password-reset email delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TrustShield <no-reply@example.com>
